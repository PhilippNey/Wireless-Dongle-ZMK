if SHIELD_SOFLE_CHOC_PRO_DONGLE

config ZMK_KEYBOARD_NAME
    default "Sofle Dongle"

config ZMK_SPLIT_ROLE_CENTRAL
    default y

config ZMK_SPLIT
    default y

# Zwei Peripherals: linke und rechte Hälfte
config ZMK_SPLIT_BLE_CENTRAL_PERIPHERALS
    default 2

# Peripherals + 5 Bluetooth-Profile
config BT_MAX_CONN
    default 7

config BT_MAX_PAIRED
    default 7

endif
